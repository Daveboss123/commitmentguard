# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database / Auth (optional for the local demo store)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret (server-side only, required)
AUTH_SECRET=

# SERV Reasoning (required for real AI extraction)
SERV_ENABLED=true
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Kite Passport (mock is the safe default)
KITE_MODE=mock
KITE_EXECUTION_MODE=simulated
KITE_CLI_PATH=kpass
KITE_DEMO_CHECKOUT_URL=
KITE_MAX_TOTAL_USDC=0.05
KITE_MAX_PER_TX_USDC=0.05
KITE_SESSION_TTL=30m

# Optional Reppo evaluation
REPPO_ENABLED=false
REPPO_API_KEY=

# Uploads
MAX_UPLOAD_MB=10

# Local demo store
DEMO_PERSIST=true

# Shared hosted demo store (server-side only; never use NEXT_PUBLIC_ prefixes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate keys per app/environment; do not point preview at production data.
# This legacy default is retained so renaming the app does not reset its data.
UPSTASH_REDIS_KEY=commitmentguard:database:v1
